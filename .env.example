# Server-only. Read by the local dev/preview proxy for the Virtual KC chat and never sent to the
# browser. Do not rename these with a VITE_ prefix.
#
# To create a key:
#   1. Sign in at https://platform.openai.com/api-keys
#   2. Select "Create new secret key", name it, and copy it (it is shown only once).
#   3. Add credit under Billing in your OpenAI account settings; the API requires it.
#   4. Copy this file to .env and paste the key below. .env is git-ignored.
OPENAI_API_KEY=
# Optional model override (defaults to the model in src/chat/config.ts).
OPENAI_MODEL=
